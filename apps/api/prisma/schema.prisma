// The Forge War — players, sessions, cloud saves, PvP, social (PostgreSQL / Prisma 7)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Registered player (email+password and/or Google/Apple OAuth).
model Player {
  id            String               @id @default(cuid())
  email         String               @unique
  /// Null for OAuth-only accounts
  passwordHash  String?
  /// Password signups start false; OAuth with verified email is true
  emailVerified Boolean              @default(false)
  /// user | admin
  role          String               @default("user")
  /// Public nickname
  displayName   String?
  /// Curated avatar p0–p4 or data-URL custom image
  avatarKey     String?
  /// Google `sub` claim
  googleSub     String?              @unique
  /// Apple `sub` claim
  appleSub      String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  save          GameSave?
  pvpDefense    PvpDefense?
  emailTokens   EmailVerifyToken[]
  passwordReset PasswordResetToken[]
  pvpAttacked   PvpMatch[]           @relation("PvpAttacker")
  pvpDefended   PvpMatch[]           @relation("PvpDefender")
  friendsSent   Friendship[]         @relation("FriendRequester")
  friendsRecv   Friendship[]         @relation("FriendAddressee")
  messagesSent  ChatMessage[]        @relation("MessageSender")
  messagesRecv  ChatMessage[]        @relation("MessageReceiver")
}

/// Opaque bearer session (raw token only returned at issue time).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([playerId])
}

/// One-time email verification token (hash only stored).
model EmailVerifyToken {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([playerId])
}

/// One-time password reset token (hash only stored).
model PasswordResetToken {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([playerId])
}

/// Authenticated cloud campaign blob only (no anonymous guest saves).
model GameSave {
  id        String   @id @default(cuid())
  playerId  String   @unique
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Full game state as JSON string
  data      String   @db.Text
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

/// Async PvP: ghost squad defended by AI against attackers.
model PvpDefense {
  playerId    String   @id
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  displayName String?
  avatarKey   String?
  /// Rough power for matchmaking filter
  power       Int      @default(0)
  /// JSON: { warriors, items } — built from server cloud save only
  squadJson   String   @db.Text
  wins        Int      @default(0)
  losses      Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([power])
  @@index([updatedAt])
}

/// Short-lived challenge required before a human PvP result counts.
model PvpMatch {
  id          String    @id @default(cuid())
  attackerId  String
  attacker    Player    @relation("PvpAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defenderId  String
  defender    Player    @relation("PvpDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  /// open | resolved | expired
  status      String    @default("open")
  victory     Boolean?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
  @@index([status, expiresAt])
}

/// Friend request / accepted friendship (ordered pair uniqueness).
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   Player   @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   Player   @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  /// pending | accepted | blocked
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Direct messages between friends.
model ChatMessage {
  id         String    @id @default(cuid())
  senderId   String
  sender     Player    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   Player    @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String    @db.VarChar(2000)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([receiverId, createdAt])
  @@index([senderId, receiverId, createdAt])
}
