# Copy to .env and adjust
# Local compose password default: tfw_local_dev_only (see docker-compose.yml)
DATABASE_URL="postgresql://tfw:tfw_local_dev_only@localhost:5433/tfw?schema=public"
PORT=8787
NODE_ENV=development

# Comma-separated exact browser origins
WEB_ORIGIN=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000

# Session cookie
# Production: COOKIE_SAMESITE=None COOKIE_SECURE=1 (cross-subdomain web/api)
COOKIE_SAMESITE=Lax
COOKIE_SECURE=0
# COOKIE_DOMAIN=.example.com
# RETURN_AUTH_TOKEN=1  # force token in JSON body (dev default on; prod default off)

TRUST_PROXY=1

# Dev: verification token in register JSON (forced off when NODE_ENV=production)
ALLOW_DEV_EMAIL_TOKEN=1

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=0
# REQUIRE_SMTP=1   # production: fail boot without SMTP unless 0

# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_REDIRECT_URI=http://localhost:3000
