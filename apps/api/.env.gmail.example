# --- Gmail SMTP (no custom domain) — copy to Render Environment ---
# 1. Google Account → Security → 2-Step Verification ON
# 2. App passwords → create "Mail" → copy 16-char password
# 3. Remove RESEND_API_KEY from Render (or leave empty) so Gmail is used
#
# MAIL_PREFER_SMTP=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=madatyanh@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=The Forge War <madatyanh@gmail.com>
# REQUIRE_SMTP=1
# RETURN_VERIFY_TOKEN_ON_MAIL_FAIL=0
