# Copy to .env.prod and fill secrets. Never commit .env.prod.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=tfw
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=tfw

# Public HTTPS origins (no trailing slash)
WEB_ORIGIN=https://game.example.com
WEB_PUBLIC_URL=https://game.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/v1

# Cookies for cross-subdomain API (game. + api.) → SameSite=None; Secure
COOKIE_SAMESITE=None
COOKIE_SECURE=1
# Optional shared parent: COOKIE_DOMAIN=.example.com

# Email (required when REQUIRE_SMTP=1)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Forge War <noreply@example.com>
SMTP_SECURE=0
REQUIRE_SMTP=1

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_REDIRECT_URI=https://game.example.com
